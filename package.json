{
  "name": "dsh-vocab-digest",
  "version": "1.0.0",
  "type": "module",
  "description": "读取弹幕与字幕，抽取英语词汇并按标签整理成 Word",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/pipeline.js"
  },
  "bin": {
    "vocab-english": "./bin/vocab-english.js"
  },
  "files": [
    "src",
    "bin",
    "config.default.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/",
    "digest": "node bin/vocab-english.js digest",
    "check:enc": "node tools/check-encoding.mjs",
    "verify": "node tools/check-encoding.mjs && node --test --test-isolation=none test/"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "vocabulary",
    "subtitle",
    "danmaku",
    "docx"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true
}
